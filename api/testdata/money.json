{
  "_comment": "Shared money test vectors, run by both server/internal/domain (Go) and app/test/money_test.dart (Dart). Amounts are decimal strings; 'minor' is the integer number of minor units. Errors are stable codes.",
  "parse": [
    { "input": "12.34", "digits": 2, "minor": "1234" },
    { "input": "12.3", "digits": 2, "minor": "1230" },
    { "input": "12", "digits": 2, "minor": "1200" },
    { "input": "0.05", "digits": 2, "minor": "5" },
    { "input": "-7.5", "digits": 2, "minor": "-750" },
    { "input": "-0", "digits": 2, "minor": "0" },
    { "input": "007.10", "digits": 2, "minor": "710" },
    { "input": "12.340", "digits": 2, "minor": "1234" },
    { "input": "1000", "digits": 0, "minor": "1000" },
    { "input": "1.0", "digits": 0, "minor": "1" },
    { "input": "12.3456", "digits": 4, "minor": "123456" },
    { "input": "9999999999999.99", "digits": 2, "minor": "999999999999999" },
    { "input": "12.345", "digits": 2, "error": "too_many_decimals" },
    { "input": "1.5", "digits": 0, "error": "too_many_decimals" },
    { "input": "10000000000000.00", "digits": 2, "error": "amount_too_large" },
    { "input": "99999999999999999999999", "digits": 2, "error": "amount_too_large" },
    { "input": "", "digits": 2, "error": "invalid_amount" },
    { "input": "1.", "digits": 2, "error": "invalid_amount" },
    { "input": ".5", "digits": 2, "error": "invalid_amount" },
    { "input": "1,000", "digits": 2, "error": "invalid_amount" },
    { "input": "+1", "digits": 2, "error": "invalid_amount" },
    { "input": "1e3", "digits": 2, "error": "invalid_amount" },
    { "input": " 1", "digits": 2, "error": "invalid_amount" },
    { "input": "-", "digits": 2, "error": "invalid_amount" },
    { "input": "١٢", "digits": 2, "error": "invalid_amount" }
  ],
  "format": [
    { "minor": "1234", "digits": 2, "output": "12.34" },
    { "minor": "5", "digits": 2, "output": "0.05" },
    { "minor": "-5", "digits": 2, "output": "-0.05" },
    { "minor": "0", "digits": 2, "output": "0.00" },
    { "minor": "1200", "digits": 0, "output": "1200" },
    { "minor": "-1200", "digits": 0, "output": "-1200" },
    { "minor": "123456789", "digits": 4, "output": "12345.6789" },
    { "minor": "7", "digits": 4, "output": "0.0007" },
    { "minor": "999999999999999", "digits": 2, "output": "9999999999999.99" }
  ],
  "split": [
    {
      "name": "equal thirds: leftover cent goes to the lowest member id",
      "amount": "100.00", "digits": 2, "method": "equal",
      "parts": [{ "member": "c" }, { "member": "a" }, { "member": "b" }],
      "expect": { "a": "33.34", "b": "33.33", "c": "33.33" }
    },
    {
      "name": "equal, fewer cents than people",
      "amount": "0.05", "digits": 2, "method": "equal",
      "parts": [{ "member": "a" }, { "member": "b" }, { "member": "c" }, { "member": "d" }, { "member": "e" }, { "member": "f" }],
      "expect": { "a": "0.01", "b": "0.01", "c": "0.01", "d": "0.01", "e": "0.01", "f": "0.00" }
    },
    {
      "name": "equal, even",
      "amount": "10", "digits": 2, "method": "equal",
      "parts": [{ "member": "a" }, { "member": "b" }],
      "expect": { "a": "5.00", "b": "5.00" }
    },
    {
      "name": "equal, zero decimal places",
      "amount": "100", "digits": 0, "method": "equal",
      "parts": [{ "member": "a" }, { "member": "b" }, { "member": "c" }],
      "expect": { "a": "34", "b": "33", "c": "33" }
    },
    {
      "name": "equal, largest amount",
      "amount": "9999999999999.99", "digits": 2, "method": "equal",
      "parts": [{ "member": "a" }, { "member": "b" }, { "member": "c" }],
      "expect": { "a": "3333333333333.33", "b": "3333333333333.33", "c": "3333333333333.33" }
    },
    {
      "name": "equal, nobody",
      "amount": "10.00", "digits": 2, "method": "equal",
      "parts": [],
      "error": "no_members"
    },
    {
      "name": "equal, duplicate member",
      "amount": "10.00", "digits": 2, "method": "equal",
      "parts": [{ "member": "a" }, { "member": "a" }],
      "error": "duplicate_member"
    },
    {
      "name": "exact",
      "amount": "50.00", "digits": 2, "method": "exact",
      "parts": [{ "member": "a", "value": "20" }, { "member": "b", "value": "30.00" }],
      "expect": { "a": "20.00", "b": "30.00" }
    },
    {
      "name": "exact, does not add up",
      "amount": "50.00", "digits": 2, "method": "exact",
      "parts": [{ "member": "a", "value": "20" }, { "member": "b", "value": "29.99" }],
      "error": "exact_total"
    },
    {
      "name": "exact, negative part",
      "amount": "50.00", "digits": 2, "method": "exact",
      "parts": [{ "member": "a", "value": "60" }, { "member": "b", "value": "-10" }],
      "error": "invalid_share"
    },
    {
      "name": "exact, too precise",
      "amount": "50.00", "digits": 2, "method": "exact",
      "parts": [{ "member": "a", "value": "25.001" }, { "member": "b", "value": "24.999" }],
      "error": "invalid_share"
    },
    {
      "name": "shares in thirds: leftover goes to the largest remainder",
      "amount": "100.00", "digits": 2, "method": "shares",
      "parts": [{ "member": "a", "value": "33.3333" }, { "member": "b", "value": "33.3333" }, { "member": "c", "value": "33.3334" }],
      "expect": { "a": "33.33", "b": "33.33", "c": "33.34" }
    },
    {
      "name": "shares on the largest amount need more than 64 bits in between",
      "amount": "9999999999999.99", "digits": 2, "method": "shares",
      "parts": [{ "member": "a", "value": "33.3333" }, { "member": "b", "value": "33.3333" }, { "member": "c", "value": "33.3334" }],
      "expect": { "a": "3333330000000.00", "b": "3333330000000.00", "c": "3333339999999.99" }
    },
    {
      "name": "shares with more than 4 decimals",
      "amount": "100.00", "digits": 2, "method": "shares",
      "parts": [{ "member": "a", "value": "33.33333" }, { "member": "b", "value": "66.66667" }],
      "error": "invalid_share"
    },
    {
      "name": "shares negative",
      "amount": "100.00", "digits": 2, "method": "shares",
      "parts": [{ "member": "a", "value": "110" }, { "member": "b", "value": "-10" }],
      "error": "invalid_share"
    },
    {
      "name": "shares with a zero share",
      "amount": "100.00", "digits": 2, "method": "shares",
      "parts": [{ "member": "a", "value": "1" }, { "member": "b", "value": "2" }, { "member": "c", "value": "0" }],
      "expect": { "a": "33.33", "b": "66.67", "c": "0.00" }
    },
    {
      "name": "fractional shares, remainder tie goes to the lowest member id",
      "amount": "1.00", "digits": 2, "method": "shares",
      "parts": [{ "member": "b", "value": "1.5" }, { "member": "a", "value": "1.5" }, { "member": "c", "value": "1" }],
      "expect": { "a": "0.38", "b": "0.37", "c": "0.25" }
    },
    {
      "name": "shares all zero",
      "amount": "1.00", "digits": 2, "method": "shares",
      "parts": [{ "member": "a", "value": "0" }, { "member": "b", "value": "0" }],
      "error": "no_shares"
    },
    {
      "name": "shares not a number",
      "amount": "1.00", "digits": 2, "method": "shares",
      "parts": [{ "member": "a", "value": "one" }],
      "error": "invalid_share"
    }
  ],
  "settle": [
    {
      "name": "two debtors, one creditor",
      "digits": 2,
      "nets": { "a": "30", "b": "-10", "c": "-20" },
      "expect": [
        { "from": "c", "to": "a", "amount": "20.00" },
        { "from": "b", "to": "a", "amount": "10.00" }
      ]
    },
    {
      "name": "everyone settled",
      "digits": 2,
      "nets": { "a": "0", "b": "0" },
      "expect": []
    },
    {
      "name": "ties are broken by member id",
      "digits": 2,
      "nets": { "d": "-10", "c": "-10", "b": "10", "a": "10" },
      "expect": [
        { "from": "c", "to": "a", "amount": "10.00" },
        { "from": "d", "to": "b", "amount": "10.00" }
      ]
    },
    {
      "name": "cents",
      "digits": 2,
      "nets": { "a": "-15.50", "b": "5.25", "c": "10.25" },
      "expect": [
        { "from": "a", "to": "c", "amount": "10.25" },
        { "from": "a", "to": "b", "amount": "5.25" }
      ]
    },
    {
      "name": "largest debtor pays largest creditor first",
      "digits": 0,
      "nets": { "a": "-50", "b": "-30", "c": "20", "d": "60" },
      "expect": [
        { "from": "a", "to": "d", "amount": "50" },
        { "from": "b", "to": "c", "amount": "20" },
        { "from": "b", "to": "d", "amount": "10" }
      ]
    },
    {
      "name": "nets do not add up to zero",
      "digits": 2,
      "nets": { "a": "1", "b": "-2" },
      "error": "unbalanced"
    }
  ]
}
