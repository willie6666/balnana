# Copy to .env and edit. Read by docker-compose.yml.
# Every BALNANA_* variable here is passed to the server.
#
# Most settings can instead be changed while the server runs, at /admin (the
# app sends you there to set the administrator password the first time).
# Those are marked [admin] below. A variable you set here wins: /admin shows
# it but cannot change it. Leave them out to manage them at /admin.

# --- Required --------------------------------------------------------------------

# Database password, for example the output of:  openssl rand -hex 24
# or:  python3 -c 'import secrets; print(secrets.token_hex(24))'
# Avoid "$" (compose reads it as a variable) or write it as "$$".
POSTGRES_PASSWORD=

# --- Optional ----------------------------------------------------------------------

# Advanced binary/development settings. Compose supplies the database settings
# and expects the server to listen on :8080 inside its container.
# BALNANA_LISTEN=:8080
# BALNANA_DATABASE_URL=postgres://balnana@localhost:5432/balnana?sslmode=disable
# Database password may instead be supplied separately from the URL.
# BALNANA_DATABASE_PASSWORD=
# DATABASE_URL is a fallback when BALNANA_DATABASE_URL is absent.
# Serve a Flutter web build from disk instead of the embedded one.
# BALNANA_WEB_DIR=/path/to/app/build/web

# [admin] The URL people use to open Balnana. Group links are built from it.
# BALNANA_PUBLIC_URL=http://localhost:8080

# Host port to publish, and the host address to publish it on (compose only).
# Use 127.0.0.1 when a reverse proxy on the same machine is the way in.
# BALNANA_PORT=8080
# BALNANA_BIND=0.0.0.0

# debug | info | warn | error
# BALNANA_LOG_LEVEL=info

# [admin] Where people can get the source code of the Balnana you run, shown in the app
# under Settings > About > Source code. Balnana is AGPL-3.0: if you run a modified
# version, point this at your modified source.
# BALNANA_SOURCE_URL=https://github.com/willie6666/balnana

# [admin] A privacy policy of your own, linked from the app's sign-in page and
# Settings > About. Without it the app shows a short built-in description of
# what the server stores. App stores ask for a public privacy policy URL.
# BALNANA_PRIVACY_URL=https://example.com/privacy

# [admin] Where the maps that show where an expense happened come from:
# "style" draws vector maps from a MapLibre style (BALNANA_MAP_STYLE), "tiles"
# shows raster tiles (BALNANA_MAP_TILES), and "off" turns maps off.
# BALNANA_MAP_SOURCE=style
# [admin] The MapLibre style.json URL for "style". The default is OpenFreeMap's
# Liberty style (https://openfreemap.org), free and with no key needed; its
# other styles, like /styles/bright and /styles/positron, work too.
# BALNANA_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty
# [admin] The raster tile URL template for "tiles", with {z}, {x} and {y}. The
# default is OpenStreetMap's own tile server, which is fine for light use under
# its tile usage policy (https://operations.osmfoundation.org/policies/tiles/).
# Busy servers should use a tile provider or a tile server of their own.
# BALNANA_MAP_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# [admin] The credit shown on every map, as the map provider asks. When empty,
# a style shows the credits it names, and tiles credit OpenStreetMap.
# BALNANA_MAP_ATTRIBUTION=

# Other web origins allowed to call the API, comma separated ("*" for any).
# Not needed for the web app this server serves itself.
# BALNANA_CORS_ORIGINS=

# API requests allowed per client IP per minute; 0 turns the limit off.
# BALNANA_RATE_LIMIT=600

# Set to true behind a reverse proxy (Caddy, Traefik, nginx) so the rate limit
# sees the real client address from X-Forwarded-For; left false, every client
# shares the proxy's address and one client's misses block them all. Only set
# it when clients cannot reach the server except through the proxy (see
# BALNANA_BIND), or they could fake their address.
# BALNANA_TRUST_PROXY=false

# --- Access ------------------------------------------------------------------------

# [admin] Every setting in this section.
# link:     no accounts; a group's private URL grants access to it (default)
# accounts: people sign in; groups are joined by invitation or link
# BALNANA_AUTH_MODE=link

# Accounts mode: allow email + password sign-in.
# BALNANA_AUTH_PASSWORD=true

# Accounts mode: must password accounts give an email address? When false,
# people sign up with a username instead and sign in with either.
# BALNANA_AUTH_REQUIRE_EMAIL=true

# Accounts mode: who may register: open | invite_only | closed. The first
# account on a server can always register, so a closed server can still be set up.
# BALNANA_AUTH_SIGNUP=open

# Accounts mode: may group owners let people in by link alone?
# BALNANA_LINK_GROUPS=true

# Accounts mode: keep accounts out of everything but their settings until they
# confirm their email, and let a trusted sign-in provider's email take over an
# account that hasn't. When false, someone signing in with a provider whose email
# matches an unconfirmed account chooses: add it to that account (with its
# password), take that account over, or start a new one. Needs email sending.
# BALNANA_AUTH_REQUIRE_VERIFIED=false

# --- Email (verification, password reset, invites); off when HOST is empty ------------
# [admin] Every setting in this section.
# Port 465 uses TLS from the start; other ports upgrade with STARTTLS when the
# server offers it. Links in emails point at BALNANA_PUBLIC_URL.
# BALNANA_SMTP_HOST=
# BALNANA_SMTP_PORT=587
# BALNANA_SMTP_USER=
# BALNANA_SMTP_PASSWORD=
# BALNANA_SMTP_FROM=Balnana <balnana@example.com>
# Emails carry sign-in links, so a mail server that offers no TLS is refused
# unless it runs on this machine. Set this (here, not at /admin) to send to one
# on your own network anyway, unencrypted.
# BALNANA_SMTP_ALLOW_PLAINTEXT=false

# --- Push notifications to the Android app (Web Push over UnifiedPush) ------------
# On unless set to false. The server makes its own VAPID key and keeps it in the database.
# BALNANA_PUSH=true
# Also send to push services on private addresses or plain http, such as an ntfy
# server on your own network. Off by default, so phones cannot make the server
# reach into its own network.
# BALNANA_PUSH_PRIVATE_ENDPOINTS=false

# --- Sign in with Google -----------------------------------------------------------
# [admin] Every setting in this section.
# Only in accounts mode. Register the redirect URI
#   <BALNANA_PUBLIC_URL>/api/v1/auth/oauth/google/callback
# with the provider. People can also add it to their account in Settings.
# BALNANA_OAUTH_GOOGLE_CLIENT_ID=
# BALNANA_OAUTH_GOOGLE_SECRET=
# Trust Google's verified email: a sign-in whose email matches an account with a
# confirmed email signs in to that account. When false, it is refused and people
# sign in with their password and add Google in Settings.
# BALNANA_OAUTH_GOOGLE_TRUST_EMAIL=true

# --- Sign in with any OpenID Connect provider (Authentik, Keycloak, ...) ------------
# [admin] Every setting in this section.
# A comma-separated list of provider IDs: lowercase letters, digits and dashes,
# up to 32, not "google". Each ID has its own settings below, named after it in
# capitals with dashes as underscores, and its own redirect URI:
#   <BALNANA_PUBLIC_URL>/api/v1/auth/oauth/<id>/callback
# The issuer URL must serve /.well-known/openid-configuration.
# BALNANA_OAUTH_OIDC_PROVIDERS=authentik
# BALNANA_OAUTH_OIDC_AUTHENTIK_ISSUER=
# BALNANA_OAUTH_OIDC_AUTHENTIK_CLIENT_ID=
# BALNANA_OAUTH_OIDC_AUTHENTIK_SECRET=
# BALNANA_OAUTH_OIDC_AUTHENTIK_NAME=Authentik
# Trust the provider's verified email, as for Google. Off by default: only turn
# it on for a provider you run or trust to check that emails belong to people.
# BALNANA_OAUTH_OIDC_AUTHENTIK_TRUST_EMAIL=false

# --- Android app links --------------------------------------------------------------
# [admin] An Android build made with --dart-define=BALNANA_SERVER_URL=<this server>
# opens this server's links in the app. List the SHA-256 fingerprints of the
# certificates such builds are signed with (keytool -list -v, or apksigner verify
# --print-certs), comma separated, and Android opens them without asking: the
# server then serves /.well-known/assetlinks.json.
# BALNANA_ANDROID_CERT_SHA256=
