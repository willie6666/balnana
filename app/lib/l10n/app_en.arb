  "privacyTitle": "Privacy policy",
  "@privacyTitle": {
    "description": "Heading for privacy title in the built-in privacy notice."
  },
  "privacyIntro": "Balnana is open-source software. Whoever runs the server this app is connected to (its operator) decides where your data is kept and is responsible for it. This page describes what the software itself stores and does.",
  "@privacyIntro": {
    "description": "Label or control text for privacy intro in the built-in privacy notice."
  },
  "privacyStoredTitle": "What is stored",
  "@privacyStoredTitle": {
    "description": "Heading for privacy stored title in the built-in privacy notice."
  },
  "privacyStoredBody": "The groups you create or join: their names, the members' names, expenses, payments, notes, any receipt photos and the places you add to expenses. With an account, also your name, your email address or username, a hash of your password (never the password itself) and which sign-in provider you use, such as Google. If notifications are on, an identifier for your device and the address its push service gave it.",
  "@privacyStoredBody": {
    "description": "Explanatory text for privacy stored body in the built-in privacy notice."
  },
  "privacyUseTitle": "How it is used",
  "@privacyUseTitle": {
    "description": "Heading for privacy use title in the built-in privacy notice."
  },
  "privacyUseBody": "Only to run the app: to show each group to its members, work out balances, and send the emails and notifications the app needs, such as address verification, password resets and invitations. The app has no ads and no analytics, and nothing is sold.",
  "@privacyUseBody": {
    "description": "Explanatory text for privacy use body in the built-in privacy notice."
  },
  "privacySharedTitle": "Who can see it",
  "@privacySharedTitle": {
    "description": "Heading for privacy shared title in the built-in privacy notice."
  },
  "privacySharedBody": "Everyone in a group sees its members, expenses and history. When a group is open by link, anyone with the link can open it. Sign-in with Google goes through Google, and notifications, when the operator turns them on, go through the push service your phone uses: Google's Firebase Cloud Messaging, or another UnifiedPush service you installed, such as ntfy. The notification's content is encrypted on the way. Maps load their pictures from the map provider the operator chose, OpenFreeMap unless they changed it, which sees your network address and which area you look at. Your own location is read only when you tap \"Use current location\", and only the point you then keep is saved.",
  "@privacySharedBody": {
    "description": "Explanatory text for privacy shared body in the built-in privacy notice."
  },
  "privacyDeviceTitle": "On this device",
  "@privacyDeviceTitle": {
    "description": "Heading for privacy device title in the built-in privacy notice."
  },
  "privacyDeviceBody": "The app keeps the server's address, your settings and a copy of your groups for when you're offline. Uninstalling the app removes them.",
  "@privacyDeviceBody": {
    "description": "Explanatory text for privacy device body in the built-in privacy notice."
  },
  "privacyDeleteTitle": "Deleting your data",
  "@privacyDeleteTitle": {
    "description": "Heading for privacy delete title in the built-in privacy notice."
  },
  "privacyDeleteBody": "You can delete your account in Settings. Your name then stays in your groups as a member nobody has claimed, so their balances still add up, and groups nobody else can reach are deleted with it. A group's owner can delete the whole group in its settings. For anything else, contact the server's operator.",
  "@privacyDeleteBody": {
    "description": "Explanatory text for privacy delete body in the built-in privacy notice."
  },
  "privacyOperatorPolicy": "The operator's privacy policy",
  "@privacyOperatorPolicy": {
    "description": "Label or control text for privacy operator policy in the built-in privacy notice."
  },
  "privacyLink": "Privacy",
  "@privacyLink": {
    "description": "Short link to the privacy policy, under the sign-in form."
  },
