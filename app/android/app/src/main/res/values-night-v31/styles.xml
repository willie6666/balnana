<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ while the process starts, when the OS's Dark Mode setting is on:
         the system splash screen shows the coin on a yellow circle. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
    </style>
    <!-- The same in wallpaper colors. MainActivity makes it the splash screen
         of later launches (Android 13+) while Wallpaper colors is on. -->
    <style name="LaunchTheme.Wallpaper">
        <item name="android:windowSplashScreenBackground">@color/splash_wallpaper_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_wallpaper_coin</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_wallpaper_icon_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
